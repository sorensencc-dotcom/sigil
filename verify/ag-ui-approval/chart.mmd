stateDiagram-v2
  state "Legend" as legend {
    lg0: waiting
    lg1: ok
    lg2: bad
    lg3: active
  }
  class lg0 orange
  class lg1 teal
  class lg2 pink
  class lg3 blue
  s0: No run yet
  s1: Streaming
  s2: Finished, no gated action
  s3: Paused for approval (approval waiting)
  s4: Stream cut
  s5: Error shown
  s6: Paused for approval (approved)
  s7: Paused for approval (approval expired)
  s8: Paused for approval (approval used)
  s9: Streaming, waiting for worker
  s10: Streaming, action done and shown
  s11: Streaming, approval expired
  s12: Finished, action done
  s13: Stream cut, action done
  [*] --> s0
  s0 --> s1: client starts a run
  s1 --> s2: agent finishes
  s1 --> s3: worker asks for approval
  s1 --> s4: connection drops
  s3 --> s5: client cancels the approval
  s3 --> s6: you approve with your key
  s3 --> s7: approval times out
  s6 --> s5: client cancels the approval
  s6 --> s7: approval times out
  s6 --> s8: worker sends the gated envelope
  s6 --> s9: client resumes [approved]
  s7 --> s5: client resumes [no usable approval]
  s8 --> s10: client resumes [action already done]
  s9 --> s10: worker sends the gated envelope
  s9 --> s11: approval times out
  s9 --> s4: connection drops
  s10 --> s12: agent finishes
  s10 --> s13: connection drops
  s11 --> s5: approval times out
  s11 --> s4: connection drops
  s4 --> s9: client retries the resume
  s4 --> s13: worker sends the gated envelope
  s13 --> s10: client retries the resume
  s4 --> s5: client retries the resume [fails]
