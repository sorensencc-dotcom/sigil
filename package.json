{
  "name": "@sorensencc/sigil",
  "version": "0.2.1",
  "description": "Governed task relay connector for Codex and Claude hosts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sigil": "bin/sigil.mjs"
  },
  "files": [
    "index.js",
    "jcs-audit-lib.mjs",
    "dep-audit-lib.mjs",
    "bin/",
    "sigil/connectors/v1/*.mjs",
    "sigil/connectors/v1/*.sql",
    "sigil/relay/v1/*.mjs",
    "sigil/contracts/v1/*.json",
    "sigil/migrations/*.sql",
    "sigil/scripts/*.mjs",
    "sigil/cli/*.mjs",
    "sigil/hooks/*.mjs",
    "README.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "node sigil/scripts/install-git-hooks.mjs",
    "secret-scan": "node sigil/scripts/secret-scan.mjs",
    "test": "node sigil-dep-audit.mjs && node sigil-jcs-audit.mjs && node --test",
    "audit:deps": "node sigil-dep-audit.mjs",
    "audit:jcs": "node sigil-jcs-audit.mjs",
    "test:live": "node sigil/scripts/live-db-tests.mjs",
    "db:migrate": "node sigil/scripts/apply-migrations.mjs",
    "receipt:claude": "node sigil/scripts/live-claude-worker-receipt.mjs",
    "prepack": "node sigil-dep-audit.mjs && node sigil-jcs-audit.mjs && node --test",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run audit:deps && npm run audit:jcs && npm test && npm pack --dry-run",
    "wiki:sync": "node sigil/scripts/sync-wiki.mjs",
    "wiki:verify-diagrams": "node sigil/scripts/verify-wiki-diagrams.mjs",
    "wiki:record-diagrams": "node sigil/scripts/verify-wiki-diagrams.mjs --write"
  },
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./connector": "./sigil/connectors/v1/connector.mjs",
    "./connector-db": "./sigil/connectors/v1/connector-db-adapter.mjs",
    "./connector-ws": "./sigil/connectors/v1/connector-ws-manager.mjs",
    "./relay": "./sigil/relay/v1/http-server.mjs",
    "./daemon": "./sigil/cli/agent-daemon.mjs",
    "./identity": "./sigil/cli/identity.mjs",
    "./vault-isolation": "./sigil/connectors/v1/vault-isolation-layer.mjs",
    "./contracts/*": "./sigil/contracts/v1/*"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorensencc-dotcom/sigil.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/sorensencc-dotcom/sigil/issues"
  },
  "homepage": "https://github.com/sorensencc-dotcom/sigil#readme",
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "canonicalize": "2.0.0",
    "pg": "8.22.0",
    "ws": "8.21.3"
  }
}
